// Academy CMS schema
// "Enum-like" fields are plain Strings (validated in app code) and lists are
// stored as JSON strings (parsed with JSON.parse/stringify in the app layer)
// so the app logic stays identical regardless of the underlying database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Fully separate from AdminUser on purpose — mobile admin access uses its own credentials
// that must never work for the desktop /admin/login, and vice versa.
model MobileAdminUser {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  // PIN sign-in is a "trusted device" quick-unlock (Apple Passcode style) rather than a
  // standalone remote credential — see DEVICE_TRUST_COOKIE in lib/mobileAdminAuth.ts. Rate
  // limiting lives on this row since serverless functions don't share in-memory state.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  createdAt         DateTime  @default(now())
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  avatarUrl    String?
  phone        String?
  gender       String?
  dateOfBirth  DateTime?
  enrollments  Enrollment[]
  createdAt    DateTime     @default(now())

  // Basic info
  displayName   String?
  username      String?
  coverImageUrl String?
  bio           String?
  location      String?

  // Learning interests
  interestsJson           String @default("[]")
  additionalInterestsJson String @default("[]")

  // Skill level, role, goals
  skillLevel        String?
  currentRole       String?
  learningGoalsJson String  @default("[]")

  // Experience
  yearsExperience String?
  currentIndustry String?
  currentCompany  String?

  // Learning style & commitment
  learningStyleJson String  @default("[]")
  weeklyCommitment  String?

  // Learning preferences
  preferredLanguage String?
  subtitleLanguage  String?
  playbackSpeed     String?
  themePreference   String?

  // Software familiarity
  softwareFamiliarityJson String @default("[]")

  // Portfolio & showcase
  portfolioUrl String?
  behanceUrl   String?
  dribbbleUrl  String?
  githubUrl    String?
  linkedinUrl  String?

  // Privacy & social
  isProfilePublic       Boolean @default(false)
  showLearningActivity  Boolean @default(true)
  showCompletedCourses  Boolean @default(true)
  allowMessages         Boolean @default(true)
  shareProjectsPublicly Boolean @default(false)
  followingEnabled      Boolean @default(true)

  // Notifications
  notifyWeeklyReminder       Boolean @default(true)
  notifyNewCourses           Boolean @default(true)
  notifyInstructorUpdates    Boolean @default(true)
  notifyAssignmentDeadlines  Boolean @default(true)
  notifyProductAnnouncements Boolean @default(false)

  // Account
  timezone String?
  country  String?

  // Batch & status
  status  String  @default("Active")
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Communication
  notificationRecipients NotificationRecipient[]
  directMessages         DirectMessage[]
  attendances            Attendance[]
}

model Enrollment {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId             String
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedModulesJson String   @default("[]")
  enrolledAt           DateTime @default(now())
  lastAccessedAt       DateTime @default(now())

  @@unique([userId, courseId])
}

model Batch {
  id                String         @id @default(cuid())
  name              String
  classTimings      String? // display string, derived from classDaysJson/startTime/endTime on save
  classDaysJson     String         @default("[]")
  startTime         String? // "HH:MM", 24-hour
  endTime           String? // "HH:MM", 24-hour
  meetingUrl        String? // Google Meet / Zoom link students are sent to after marking attendance
  completedChapters Int            @default(0) // how many of the linked course's modules the class has covered so far
  capacity          Int?
  startDate         DateTime?
  endDate           DateTime?
  courseId          String?
  course            Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  students          User[]
  notifications     Notification[]
}

model Notification {
  id               String   @id @default(cuid())
  title            String
  body             String
  scope            String // "individual" | "batch" | "all"
  batchId          String?
  batch            Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sentByAdminEmail String?
  createdAt        DateTime @default(now())

  recipients NotificationRecipient[]
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?

  @@unique([notificationId, userId])
}

model DirectMessage {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    String // "admin" | "student"
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Attendance {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date     DateTime // calendar date only (UTC midnight) — one record per student per course per day
  markedAt DateTime @default(now())

  @@unique([userId, courseId, date])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                    String   @id @default("default")
  siteName              String   @default("Academy")
  tagline               String   @default("Marketing Mastery, One Class at a Time.")
  logoUrl               String?
  faviconUrl            String?
  promoBarText          String   @default("Use promo code \"nqacademy\" to avail 50%off")
  defaultSeoTitle       String?
  defaultSeoDescription String?
  socialLinksJson       String   @default("{\"linkedin\":\"#\",\"instagram\":\"#\"}")
  siteStatus            String   @default("live") // "live" | "offline" | "password_protected"
  sitePasswordHash      String? // only set when siteStatus has been "password_protected" at least once
  updatedAt             DateTime @updatedAt
}

model MediaFolder {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  assets    MediaAsset[]
}

model MediaAsset {
  id        String       @id @default(cuid())
  url       String
  name      String?
  width     Int?
  height    Int?
  format    String?
  sizeBytes Int?
  altText   String?
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())
}

model Mentor {
  id              String   @id @default(cuid())
  name            String
  role            String
  bio             String
  imageDesktopUrl String?
  imageMobileUrl  String?
  linkedinUrl     String?
  websiteUrl      String?
  courses         Course[]
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model Course {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  level            String         @default("Beginner")
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id])
  mentorId         String?
  mentor           Mentor?        @relation(fields: [mentorId], references: [id])
  rating           Float          @default(4.5)
  reviewsCount     Int            @default(0)
  students         Int            @default(0)
  modulesCount     Int            @default(5)
  duration         String         @default("1h 30m")
  price            Float          @default(0)
  originalPrice    Float?
  imageDesktopUrl  String?
  imageMobileUrl   String?
  description      String         @default("")
  includesJson     String         @default("[]")
  keyPointsJson    String         @default("[]")
  advantagesJson   String         @default("[]")
  requirementsJson String         @default("[]")
  modulesJson      String         @default("[]")
  toolsJson        String         @default("[]")
  reviews          CourseReview[]
  enrollments      Enrollment[]
  batches          Batch[]
  attendances      Attendance[]
  seoTitle         String?
  seoDescription   String?
  published        Boolean        @default(true)
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  rating    Int      @default(5)
  date      String
  text      String
  createdAt DateTime @default(now())
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  body            String
  author          String   @default("Admin")
  date            String
  imageDesktopUrl String?
  imageMobileUrl  String?
  tagsJson        String   @default("[]")
  category        String   @default("Academy")
  seoTitle        String?
  seoDescription  String?
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String?
  page     String  @default("global")
  order    Int     @default(0)
}

model Testimonial {
  id        String  @id @default(cuid())
  quote     String
  name      String
  role      String
  avatarUrl String?
  order     Int     @default(0)
}

model GrowthPage {
  id                    String  @id @default(cuid())
  slug                  String  @unique
  eyebrow               String?
  title                 String
  titleHighlight        String
  subtitle              String
  checklistJson         String  @default("[]")
  ctaLabel              String
  heroImageDesktopUrl   String?
  heroImageMobileUrl    String?
  expectParagraph       String
  dayTabsJson           String  @default("[]")
  expectImageDesktopUrl String?
  expectImageMobileUrl  String?
  quickFactsJson        String  @default("[]")
  benefitsTitle         String
  benefitsJson          String  @default("[]")
  benefitsCta           String
  seoTitle              String?
  seoDescription        String?
}

model PricingPlan {
  id           String  @id @default(cuid())
  name         String
  tagline      String?
  price        String
  recommended  Boolean @default(false)
  featuresJson String  @default("[]")
  order        Int     @default(0)
}

model FooterLink {
  id     String @id @default(cuid())
  column String
  label  String
  href   String
  order  Int    @default(0)
}

model HeroSlide {
  id              String  @id @default(cuid())
  title           String
  subtitle        String
  ctaLabel        String
  ctaHref         String  @default("/courses")
  imageDesktopUrl String?
  imageMobileUrl  String?
  order           Int     @default(0)
}

model HomepageStat {
  id    String @id @default(cuid())
  icon  String @default("users")
  value String
  label String
  order Int    @default(0)
}

model TrustLogo {
  id       String  @id @default(cuid())
  name     String
  imageUrl String?
  order    Int     @default(0)
}

model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  dataJson  String   @default("{}")
  updatedAt DateTime @updatedAt
}
